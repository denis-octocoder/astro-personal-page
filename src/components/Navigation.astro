---
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-zinc-950/80 backdrop-blur-md border-b border-zinc-800/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center py-4">
      <!-- Logo -->
      <div class="flex items-center">
        <span class="text-xl font-bold bg-gradient-to-r from-purple-400 to-purple-600 bg-clip-text text-transparent">
          surkes.pro
        </span>
      </div>
      
      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        <a href="#about" class="text-zinc-300 hover:text-purple-400 transition-colors duration-200">About</a>
        <a href="#skills" class="text-zinc-300 hover:text-purple-400 transition-colors duration-200">Skills</a>
        <a href="#projects" class="text-zinc-300 hover:text-purple-400 transition-colors duration-200">Projects</a>
        <a href="#contact" class="text-zinc-300 hover:text-purple-400 transition-colors duration-200">Contact</a>
      </div>
      
      <!-- Mobile menu button -->
      <div class="md:hidden">
        <button id="mobile-menu-btn" class="w-10 h-10 bg-zinc-800/50 hover:bg-purple-500/20 border border-zinc-700/50 hover:border-purple-500/50 rounded-lg flex items-center justify-center text-zinc-300 hover:text-purple-400 transition-all duration-300 hover:scale-105">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
    
    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="flex flex-col space-y-2">
        <a href="#about" class="text-zinc-300 hover:text-purple-400 transition-colors duration-200 py-2">About</a>
        <a href="#skills" class="text-zinc-300 hover:text-purple-400 transition-colors duration-200 py-2">Skills</a>
        <a href="#projects" class="text-zinc-300 hover:text-purple-400 transition-colors duration-200 py-2">Projects</a>
        <a href="#contact" class="text-zinc-300 hover:text-purple-400 transition-colors duration-200 py-2">Contact</a>
      </div>
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    
    mobileMenuBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });
    
    // Close mobile menu when clicking on a link
    const mobileLinks = mobileMenu?.querySelectorAll('a');
    mobileLinks?.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu?.classList.add('hidden');
      });
    });
  });
</script>