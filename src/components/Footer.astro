---
const today = new Date();
---

<footer class="bg-zinc-950 border-t border-zinc-800/50 py-8">
<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
	<div class="text-center">
	<div class="mb-4">
		<span class="text-2xl font-bold bg-gradient-to-r from-purple-400 to-purple-600 bg-clip-text text-transparent">
		surkes.pro
		</span>
	</div>
	
	<p class="text-zinc-400 text-sm mb-4">
		Built with ❤️ by Octocoder.ai
	</p>
	
	<div class="flex justify-center space-x-4 text-sm text-zinc-500">
		<span>&copy; {today.getFullYear()} Denis Surkes</span>
		<span>•</span>
		<span>All rights reserved</span>
	</div>
	</div>
</div>
</footer>
