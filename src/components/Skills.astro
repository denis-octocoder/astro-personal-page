---
const skillCategories = [
  {
    title: "Programming Languages",
    icon: "👨‍💻",
    skills: ["Java", "Kotlin", "JavaScript", "TypeScript", "Python", "Go"]
  },
  {
    title: "Frameworks & Libraries",
    icon: "⚙️",
    skills: ["NestJS", "Spring Boot", "Prisma", "NextJS", "Tailwind CSS", "Astro"]
  },
  {
    title: "Tools & DevOps",
    icon: "🛠️", 
    skills: ["Docker", "AWS", "GCP", "CI/CD", "Linux", "Kubernetes"]
  }
];
---

<section id="skills" class="py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
        Technical <span class="text-purple-400">Skills</span>
      </h2>
      <div class="w-24 h-1 bg-gradient-to-r from-purple-600 to-purple-400 mx-auto rounded-full"></div>
      <p class="text-xl text-zinc-400 mt-6 max-w-2xl mx-auto">
        Technologies and tools I use to bring ideas to life
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {skillCategories.map((category) => (
        <div class="group bg-zinc-900/50 rounded-2xl p-6 border border-zinc-800/50 hover:border-purple-500/50 transition-all duration-300 hover:transform hover:scale-105">
          <div class="text-center mb-6">
            <div class="text-4xl mb-4">{category.icon}</div>
            <h3 class="text-2xl font-semibold text-white group-hover:text-purple-300 transition-colors duration-300">
              {category.title}
            </h3>
          </div>
          
          <div class="grid grid-cols-2 gap-3">
            {category.skills.map((skill) => (
              <div class="bg-zinc-800/50 rounded-lg px-3 py-2 text-sm text-zinc-300 text-center border border-zinc-700/50 hover:border-purple-500/50 hover:text-purple-300 transition-all duration-200">
                {skill}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>